OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG, INFO (default), WARNING, ERROR -- see app/logging_config.py. Every
# backend request logs to both the console and ~/product-studio-logs/backend.log;
# Knowledge Base's step-by-step trace (upload/replace/delete, chunking,
# embedding, search) is all at INFO, visible without changing this. DEBUG
# also unmutes httpx/openai/chromadb's own request-level logs.
LOG_LEVEL=INFO

# Every LLM call in the backend (Flowchart, Sequence, Infographic, Story
# Builder, AND Spec Builder) goes through one switchable provider -- see
# backend/app/llm_client.py. "openai" (default) uses OPENAI_API_KEY/
# OPENAI_MODEL above. "corporate" routes to your internal LLM gateway
# instead, once CorporateLLMProvider is implemented (see its docstring in
# llm_client.py -- it's an unimplemented stub until you fill in your
# endpoint's actual request/response shape and auth).
LLM_PROVIDER=openai
# CORPORATE_LLM_BASE_URL=https://your-internal-llm-gateway.example.com
# CORPORATE_LLM_API_KEY=your-corporate-llm-key
# CORPORATE_LLM_MODEL=your-corporate-model-name

# Optional: only needed to push Epics/Stories to a real Jira project from the
# Epics section of a spec (Spec Builder). Leave unset to skip -- the push
# button just won't show up. Generate an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@your-company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=PROJ
